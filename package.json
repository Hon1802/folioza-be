{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "proto:user": "protoc --plugin=node_modules/.bin/protoc-gen-ts_proto -I=./node_modules/vtd-common-v3/proto --ts_proto_out=src/proto/ node_modules/vtd-common-v3/proto/user.proto --ts_proto_opt=nestJs=true --ts_proto_opt=fileSuffix=.pb"
  },
  "dependencies": {
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.2.0",
    "@google-cloud/storage": "^7.17.3",
    "@kafkajs/confluent-schema-registry": "3.3.0",
    "@liaoliaots/nestjs-redis": "^10.0.0",
    "@nestjs/axios": "1.0.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "2.2.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "1.4.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/platform-socket.io": "^11.1.3",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "9.2.2",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer": "^2.0.0",
    "awesome-phonenumber": "^7.5.0",
    "bcrypt": "^6.0.0",
    "boolean": "3.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.13.2",
    "clone": "2.1.2",
    "cross-env": "7.0.3",
    "dayjs": "1.11.7",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "2.2.3",
    "lodash": "^4.17.21",
    "mime-types": "2.1.35",
    "mustache": "4.2.0",
    "nestjs-typeorm-paginate": "4.0.3",
    "pg": "8.8.0",
    "protobufjs": "7.1.2",
    "radash": "^11.0.0",
    "random-number-csprng": "1.0.2",
    "redis": "^5.8.3",
    "reflect-metadata": "0.1.13",
    "rimraf": "3.0.2",
    "rxjs": "7.2.0",
    "serialize-error": "8.0.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.25",
    "typeorm-transactional": "0.4.1"
  },
  "devDependencies": {
    "@nestjs/cli": "9.1.5",
    "@nestjs/schematics": "9.0.3",
    "@nestjs/testing": "^11.0.1",
    "@types/clone": "2.1.1",
    "@types/cron": "2.0.0",
    "@types/express": "4.17.13",
    "@types/jest": "27.0.2",
    "@types/mime-types": "2.1.4",
    "@types/mustache": "4.2.5",
    "@types/node": "20.3.2",
    "@types/pg": "8.6.6",
    "@types/random-number-csprng": "1.0.0",
    "@types/supertest": "2.0.11",
    "@types/validator": "13.11.7",
    "@typescript-eslint/eslint-plugin": "5.0.0",
    "@typescript-eslint/parser": "5.0.0",
    "eslint": "8.0.1",
    "eslint-config-prettier": "8.3.0",
    "eslint-plugin-prettier": "4.0.0",
    "jest": "27.2.5",
    "prettier": "2.3.2",
    "source-map-support": "0.5.20",
    "supertest": "6.1.3",
    "ts-jest": "27.0.3",
    "ts-loader": "9.2.3",
    "ts-node": "10.0.0",
    "ts-proto": "1.135.0",
    "tsconfig-paths": "3.10.1",
    "typescript": "^5.4.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
